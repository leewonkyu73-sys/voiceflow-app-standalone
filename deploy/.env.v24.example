# STAR45 AI Meeting Workspace v2.6 Environment
NODE_ENV=production
MEETING_PUBLIC_BASE_URL=https://voice.star45.net

# AI providers (optional for AI Employee service)
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=

# Calendar connectors
GOOGLE_CLIENT_ID=
MS_CLIENT_ID=

# Google Drive - official meeting result storage
# Create a Google OAuth Web Application once, then connect the account from /drive-connect.html.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_TOKEN_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=https://voice.star45.net/api/v1/meeting-results/oauth/callback
# Optional legacy/manual fallback. Normally leave empty after OAuth wizard is enabled.
GOOGLE_DRIVE_REFRESH_TOKEN=
# Optional. If empty, the app finds or creates "STAR45 Meeting" after OAuth connection.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
MEETING_DRIVE_TENANT_NAME=Default

# ERP
ERP_API_BASE=
ERP_API_TOKEN=

# Obsidian / Hermes - knowledge layer after Drive approval
OBSIDIAN_HOST_PATH=/opt/star45/obsidian-vault
OBSIDIAN_VAULT_PATH=/vault
HERMES_ENABLED=true
HERMES_HOST_BRIDGE_DIR=/opt/star45/hermes-bridge
HERMES_BRIDGE_DIR=/hermes-bridge

# Discord - notification / scheduled event / voice channel connector
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_NOTICE_CHANNEL_ID=
DISCORD_TASK_CHANNEL_ID=
DISCORD_VOICE_CHANNEL_ID=
DISCORD_ACTIVITY_APP_ID=

AUTOMATION_POLL_MS=10000
