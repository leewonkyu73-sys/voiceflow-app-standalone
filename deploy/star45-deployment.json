{
  "schema_version": "2.5",
  "project_name": "star45-ai-meeting-workspace",
  "display_name": "STAR45 AI Meeting Workspace",
  "deployment_provider": "docker-compose-vps",
  "repository": "leewonkyu73-sys/voiceflow-smart-workspace",
  "branch": "main",
  "compose_file": "deploy/docker-compose.v23.yml",
  "release_version": "2.6.1",
  "product_mode": "meeting-first",
  "runtime": {
    "public_port": 4173,
    "health_path": "/api/health",
    "version_path": "/version.json",
    "persistent_data": "/opt/star45/voiceflow-data",
    "restart_policy": "unless-stopped"
  },
  "services": [
    {"name":"gateway","container":"voiceflow-gateway-v26","port":4173,"health":"/api/health"},
    {"name":"meeting-core","container":"voiceflow-core-v26","port":4180,"health":"/api/health"},
    {"name":"board","container":"voiceflow-board-v26","port":4175,"health":"/health","role":"optional-followup-module"},
    {"name":"tasks","container":"voiceflow-tasks-v26","port":4176,"health":"/health","role":"optional-followup-module"},
    {"name":"ai-employees","container":"voiceflow-ai-v26","port":4177,"health":"/health","role":"meeting-participant-module"},
    {"name":"connectors-v6","container":"voiceflow-connectors-v26","port":4178,"health":"/health","role":"optional-connector-module"},
    {"name":"meeting-result-drive","container":"voiceflow-meeting-results-v26","port":4179,"health":"/health","role":"official-result-storage"},
    {"name":"automation-worker","container":"voiceflow-automation-v26","type":"worker","health":"process-running"}
  ],
  "routing": [
    {"path":"/api/v1/meeting-results","service":"meeting-result-drive"},
    {"path":"/api/v1/board","service":"board"},
    {"path":"/api/v1/tasks","service":"tasks"},
    {"path":"/api/v1/ai-employees","service":"ai-employees"},
    {"path":"/api/v1/ai-meeting","service":"ai-employees"},
    {"path":"/api/v1/ai-memory","service":"ai-employees"},
    {"path":"/api/v1/ai-actions","service":"ai-employees"},
    {"path":"/api/v1/connectors","service":"connectors-v6"},
    {"path":"/api/v1/obsidian","service":"connectors-v6"},
    {"path":"/api/v1/hermes","service":"connectors-v6"},
    {"path":"/api/v1/discord","service":"connectors-v6"},
    {"path":"*","service":"meeting-core"}
  ],
  "meeting_result_policy": {
    "official_source": "google-drive",
    "approval_required": true,
    "db_stores_binary_files": false,
    "db_reference_fields": ["drive_file_id","drive_folder_id","drive_url","mime_type","version","approved_at"],
    "postprocess_only_after_drive_approval": true,
    "oauth_scope": "https://www.googleapis.com/auth/drive.file",
    "refresh_token_source": "encrypted-server-oauth-store"
  },
  "deployment_guards": {
    "force_no_cache_build": true,
    "force_recreate_containers": true,
    "runtime_version_required": "2.6.1",
    "required_ui_fingerprints": ["STAR45 AI MEETING WORKSPACE","회의결과 검토","approveResult"],
    "cache_bust_assets": "2.6.1"
  },
  "automation": {
    "approved_drive_result_to_obsidian": true,
    "approved_drive_result_to_hermes": true,
    "approved_drive_result_to_discord": true,
    "task_to_discord_event": true,
    "approval_gated_ai_actions": true
  },
  "domain": {"suggested_subdomain":"voice.star45.net","https":true},
  "environment": [
    {"name":"NODE_ENV","value":"production","secret":false},
    {"name":"MEETING_PUBLIC_BASE_URL","value":"https://voice.star45.net","secret":false},
    {"name":"OPENAI_API_KEY","secret":true},
    {"name":"GEMINI_API_KEY","secret":true},
    {"name":"ANTHROPIC_API_KEY","secret":true},
    {"name":"GOOGLE_CLIENT_ID","secret":true},
    {"name":"MS_CLIENT_ID","secret":true},
    {"name":"GOOGLE_DRIVE_CLIENT_ID","secret":true},
    {"name":"GOOGLE_DRIVE_CLIENT_SECRET","secret":true},
    {"name":"GOOGLE_DRIVE_TOKEN_SECRET","secret":true},
    {"name":"GOOGLE_DRIVE_REDIRECT_URI","value":"https://voice.star45.net/api/v1/meeting-results/oauth/callback","secret":false},
    {"name":"GOOGLE_DRIVE_REFRESH_TOKEN","secret":true,"optional":true,"description":"legacy/manual fallback only; normally populated by in-app OAuth"},
    {"name":"GOOGLE_DRIVE_ROOT_FOLDER_ID","secret":false,"optional":true},
    {"name":"MEETING_DRIVE_TENANT_NAME","value":"Default","secret":false},
    {"name":"ERP_API_BASE","secret":true},
    {"name":"ERP_API_TOKEN","secret":true},
    {"name":"OBSIDIAN_VAULT_PATH","value":"/vault","secret":false},
    {"name":"OBSIDIAN_HOST_PATH","value":"/opt/star45/obsidian-vault","secret":false},
    {"name":"HERMES_ENABLED","value":"1","secret":false},
    {"name":"HERMES_BRIDGE_DIR","value":"/hermes-bridge","secret":false},
    {"name":"HERMES_HOST_BRIDGE_DIR","value":"/opt/star45/hermes-bridge","secret":false},
    {"name":"DISCORD_BOT_TOKEN","secret":true},
    {"name":"DISCORD_GUILD_ID","secret":false},
    {"name":"DISCORD_NOTICE_CHANNEL_ID","secret":false},
    {"name":"DISCORD_TASK_CHANNEL_ID","secret":false},
    {"name":"DISCORD_VOICE_CHANNEL_ID","secret":false},
    {"name":"DISCORD_ACTIVITY_APP_ID","secret":false},
    {"name":"AUTOMATION_POLL_MS","value":"10000","secret":false}
  ],
  "post_deploy_checks": [
    "/api/health",
    "/version.json",
    "/",
    "/meeting-preview.html",
    "/drive-connect.html",
    "/work-calendar.html",
    "/ai-employee-admin.html",
    "/ai-meeting-lab.html",
    "/integration-center-v6.html"
  ],
  "post_deploy_manual_step": "Admin login -> /drive-connect.html -> Google Drive 연결 -> consent -> 테스트 파일 저장 -> meeting browser E2E",
  "rollback": {"enabled":true,"keep_releases":5,"preserve_data":true}
}
