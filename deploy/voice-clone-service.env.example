# Shared voice clone orchestration service
NODE_ENV=production
VOICE_CLONE_PORT=4188
VOICE_CLONE_DATA_DIR=/data/voice-clone
VOICE_CLONE_SERVICE_TOKEN=replace-with-integration-hub-secret-reference

# PC GPU worker uses a separate least-privilege token.
VOICE_GPU_WORKER_TOKEN=replace-with-separate-integration-hub-secret-reference
VOICE_PC_GPU_ENABLED=false
VOICE_MAX_OUTPUT_BYTES=104857600

# Provider configuration belongs in Integration Hub.
VOICE_CLONE_COSYVOICE_INTEGRATION_ID=cosyvoice-3-pc-worker
VOICE_CLONE_OPENVOICE_INTEGRATION_ID=openvoice-v2-local
VOICE_CLONE_SUPERTONIC_INTEGRATION_ID=supertonic-3-local
